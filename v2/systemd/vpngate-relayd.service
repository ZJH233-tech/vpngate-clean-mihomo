[Unit]
Description=VPNGate Relay v2 control plane (active-standby JP watchdog + Argo gateway + subscriptions)
After=network-online.target tailscaled.service vpngate-singbox.service
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/vpngate-relay/secrets.env
ExecStart=/usr/local/bin/vpngate-relayd -config /etc/vpngate-relay/config.json
Restart=always
RestartSec=3
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
