# ── VPNGate 优选器运行配置示例 ──────────────────────────────
# 用法：复制为 vpngate.env（与 bestip_refresh.py 同目录，默认 /opt/vpngate/）
#   cp vpngate.env.example vpngate.env  然后按需修改

# 自建 Worker 的 /api/servers 完整地址（推荐，带 IP 纯净度画像）。
# 留空则只回源 VPNGate 官方 CSV（可用，但没有纯净度/风险评分）。
VPNGATE_WORKER=https://your-worker.workers.dev/api/servers

# 限定出口国家/地区，填两位 ISO 代码；留空表示全球。日本固定出口填 JP。
VPNGATE_CC=JP

# 1 = 纯净优先：非代理/非机房且 clean>=50 的住宅/ISP 节点排前面，
#     官方公共集群(已知公共代理)放候选池末尾兜底，保证永不彻底断连。
# 0 = 速度优先：只按 VPNGate 综合分/速度排序。
VPNGATE_CLEAN=1

# 候选池大小（定时刷新 + 看门狗故障切换都从这里挑）
POOL=12
